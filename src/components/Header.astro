---
const pathname = Astro.url.pathname;
const links = [
  { href: "/", label: "Home", active: pathname === "/" },
  { href: "/providers", label: "Providers", active: pathname.startsWith("/providers") },
  {
    href: "https://cafecito.app/shirtscanner",
    label: "Contribute",
    active: false,
    external: true,
    posthog: "contribute-button-clicked",
  },
  {
    href: "https://www.linkedin.com/in/fausto-moya/",
    label: "About Me",
    active: false,
    external: true,
    posthog: "about-me-button-clicked",
  },
];
---
<header class="sticky top-0 z-50 border-b border-border bg-background">
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-md focus:bg-background focus:px-3 focus:py-2 focus:text-sm focus:font-semibold focus:text-foreground"
  >
    Skip to content
  </a>
  <div class="relative flex h-16 w-full items-center justify-between px-4 sm:px-6 lg:px-8">
    <div class="flex items-center">
      <details class="md:hidden">
        <summary class="flex min-h-11 cursor-pointer items-center -ml-2 p-2" aria-label="Menu">
          <svg class="h-6 w-6 text-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </summary>
        <nav aria-label="Mobile menu" class="absolute left-0 top-16 z-50 flex w-full flex-col gap-1 border-b border-border bg-background p-4">
          {links.map((link) => (
            <a
              href={link.href}
              aria-current={link.active ? "page" : undefined}
              class={`flex min-h-11 items-center rounded-md px-3 py-2 text-base font-semibold transition-colors hover:bg-muted ${link.active ? "text-kit-navy underline underline-offset-4" : "text-foreground"}`}
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noreferrer" : undefined}
              data-posthog={link.posthog}
            >
              {link.label}
            </a>
          ))}
        </nav>
      </details>
      <a href="/" class="ml-4 lg:ml-0">
        <span class="font-display text-xl font-black uppercase tracking-[-0.03em] text-foreground">
          SHIRT<span class="text-stadium-ink">SCANNER</span>
        </span>
      </a>
    </div>
    <nav aria-label="Main" class="mx-6 hidden items-center space-x-4 md:flex lg:space-x-6">
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={link.active ? "page" : undefined}
          class={`text-sm font-semibold transition-colors hover:text-kit-navy hover:underline underline-offset-4 ${link.active ? "text-kit-navy underline underline-offset-4" : "text-foreground"}`}
          target={link.external ? "_blank" : undefined}
          rel={link.external ? "noreferrer" : undefined}
          data-posthog={link.posthog}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  import { initPostHog, capture } from "../services/posthog-client";

  initPostHog();
  capture("$pageview");

  document.querySelectorAll("[data-posthog]").forEach((el) => {
    el.addEventListener("click", () => {
      const event = el.getAttribute("data-posthog");
      if (event) capture(event);
    });
  });
</script>