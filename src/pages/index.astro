---
import "../styles/global.css";
import Header from "../components/Header.astro";
import SearchBar from "../components/SearchBar.astro";
import SEOHead from "../components/SEOHead.astro";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "ShirtScanner",
  url: "https://www.shirtscanner.com",
  description:
    "Search millions of cheap shirts across top Chinese sports clothing stores.",
  potentialAction: {
    "@type": "SearchAction",
    target: {
      "@type": "EntryPoint",
      urlTemplate:
        "https://www.shirtscanner.com/search?q={search_term_string}",
    },
    "query-input": "required name=search_term_string",
  },
};
---
<html lang="en">
  <head>
    <SEOHead
      title="ShirtScanner - Find the Best Sports Clothes in China"
      description="Search millions of cheap shirts across top Chinese sports clothing stores. Compare prices and find your next football, basketball, or sports jersey."
      jsonLd={jsonLd}
    />
  </head>
  <body>
    <Header />
    <section class="relative text-center">
      <div class="mx-auto max-w-screen-xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8 lg:py-32">
        <div class="mx-auto flex max-w-3xl flex-col">
          <h1 class="mt-1 font-extrabold uppercase tracking-tighter text-4xl lg:text-7xl">
            ShirtScanner
          </h1>
          <h2 class="order-first text-xl font-medium tracking-wide">
            Millions of cheap shirts. One simple search.
          </h2>
        </div>
        <p class="mx-auto mt-4 max-w-2xl text-l text-muted-foreground">
          Explore, Compare, and Find the Best Sports Clothes in China
        </p>
      </div>
    </section>
    <section class="relative text-center">
      <div class="mx-auto max-w-screen-xl px-4 sm:px-6 lg:px-24">
        <SearchBar />
      </div>
    </section>
  </body>
</html>