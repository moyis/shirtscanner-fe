---
import "../styles/global.css";
import Header from "../components/Header.astro";
import SearchBar from "../components/SearchBar.astro";
import SEOHead from "../components/SEOHead.astro";
import Footer from "../components/Footer.astro";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "ShirtScanner",
  url: "https://www.shirtscanner.com",
  description:
    "Search millions of cheap shirts across top Chinese sports clothing stores.",
  potentialAction: {
    "@type": "SearchAction",
    target: {
      "@type": "EntryPoint",
      urlTemplate:
        "https://www.shirtscanner.com/search?q={search_term_string}",
    },
    "query-input": "required name=search_term_string",
  },
};

const popularSearches = ["Barcelona", "Real Madrid", "Argentina", "Retro 90s"];
---
<html lang="en">
  <head>
    <SEOHead
      title="ShirtScanner - Find the Best Sports Clothes in China"
      description="Search millions of cheap shirts across top Chinese sports clothing stores. Compare prices and find your next football, basketball, or sports jersey."
      jsonLd={jsonLd}
    />
  </head>
  <body>
    <Header />
    <main id="main">
      <section class="relative overflow-hidden bg-background">
        <div class="relative mx-auto max-w-2xl px-4 py-16 text-left sm:px-6 sm:py-24">
          <p class="flex items-center gap-2 text-[0.8125rem] font-semibold uppercase tracking-[0.14em] text-stadium-ink">
            <span class="hero-tag-dot" aria-hidden="true"></span>
            Scanning every Chinese store at once
          </p>
          <h1 class="font-display mt-3 text-balance font-black uppercase leading-[0.9] tracking-[-0.03em] text-kit-navy [font-size:clamp(2.75rem,11vw,4.5rem)] [font-stretch:120%]">
            SHIRT
            <span class="ml-[0.03em] inline-block bg-volt px-[0.08em] text-volt-ink">SCANNER</span>
          </h1>
          <p class="mt-5 max-w-[520px] text-[1.0625rem] leading-[1.6] text-foreground">
            One query hits every store at the same time. See what&rsquo;s found,
            which stores answered, and the direct link to order it yourself.
          </p>
          <div class="mt-8">
            <SearchBar />
          </div>
          <div class="mt-4 flex flex-wrap gap-2">
            {popularSearches.map((q) => (
              <a
                href={`/search?q=${encodeURIComponent(q)}`}
                class="inline-flex min-h-11 items-center rounded-full border border-slate-line bg-card px-4 text-sm font-semibold text-foreground transition-all duration-200 hover:border-kit-navy hover:text-kit-navy active:scale-[0.98] focus:outline-none focus:ring-2 focus:ring-ring"
              >
                {q}
              </a>
            ))}
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>