---
import "../styles/global.css";
import Header from "../components/Header.astro";
import ProductSearch from "../components/ProductSearch";

const backendUrl = import.meta.env.PUBLIC_SHIRTSCANNER_BE;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ShirtScanner Search</title>
    <meta
      name="description"
      content="Search for shirts across Chinese sports clothing stores."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin="anonymous"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
    />
  </head>
  <body>
    <Header />
    {backendUrl && <ProductSearch client:only="react" backendUrl={backendUrl} />}
  </body>
</html>