---
import "../styles/global.css";
import Header from "../components/Header.astro";
import ProductSearch from "../components/ProductSearch";
import SEOHead from "../components/SEOHead.astro";
import Footer from "../components/Footer.astro";

const backendUrl = import.meta.env.PUBLIC_SHIRTSCANNER_BE;
---
<html lang="en">
  <head>
    <SEOHead
      title="Search Sports Shirts in China - ShirtScanner"
      description="Search millions of cheap sports shirts across Chinese stores. Football kits, basketball jerseys, and more, all in one search."
      canonicalPath="/search"
    />
  </head>
  <body>
    <Header />
    <main id="main">
      {backendUrl && <ProductSearch client:only="react" backendUrl={backendUrl} />}
    </main>
    <Footer />
  </body>
</html>